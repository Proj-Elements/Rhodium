# 本地开发：Next.js 与 Prisma CLI 读取本文件（复制为 .env）
# 本地 Prisma CLI 使用 DATABASE_URL。密码需与 Postgres 角色口令一致；
# URL 中的用户名、密码、库名含 @ : / ? # % 等字符时，需分别 URL 编码。
DATABASE_URL="postgresql://yueyu:yueyu_password@localhost:5432/yueyu?schema=public"
NEXT_PUBLIC_APP_NAME="Rhodium"
PORT="3030"
TZ="Asia/Shanghai"

# 以下变量由 docker compose 读取（compose 会自动加载同目录的 .env）。
# 访问令牌必填：运行 openssl rand -hex 32 生成后填入 .env；浏览器用户名 rhodium，密码为令牌。
RHODIUM_ACCESS_TOKEN=""
# 端口仍默认只绑定回环地址；远程访问需 HTTPS。
# APP_BIND="0.0.0.0"
# DB_BIND="0.0.0.0"
# Compose 把原始口令分别传给 Postgres 和应用 PG* 环境，入口自动 URL 编码；
# 口令含 $、# 等符号时在 .env 使用单引号。仅在首次创建数据卷时初始化角色口令。
POSTGRES_PASSWORD="" # 必填，首次初始化前填写；不得沿用公开默认口令

# 外部主机需显式加入白名单；代理终止 TLS 时同时添加准确的外部 Origin。
# RHODIUM_ALLOWED_HOSTS="ledger.example"
# RHODIUM_ALLOWED_ORIGINS="https://ledger.example"
# 仅在应用只接收单一受信边缘代理连接，且代理把 X-Forwarded-For 覆写为一个真实 IP 时开启。
# RHODIUM_TRUST_PROXY="false"
# 从原 Journal/Docker 目录迁移部署时，保留原 Compose 项目名才能继续挂载旧卷。
# COMPOSE_PROJECT_NAME="journal"
