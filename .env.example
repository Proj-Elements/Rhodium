# 本地开发：Next.js 与 Prisma CLI 读取本文件（复制为 .env）
# 密码需与 docker compose 的 POSTGRES_PASSWORD 一致；
# 若密码含 @ : / ? # 等字符，请先做 URL 编码。
DATABASE_URL="postgresql://yueyu:yueyu_password@localhost:5432/yueyu?schema=public"
NEXT_PUBLIC_APP_NAME="Rhodium"
PORT="3030"
TZ="Asia/Shanghai"

# 以下变量由 docker compose 读取（compose 会自动加载同目录的 .env）。
# 应用没有任何登录鉴权，端口默认只绑定回环地址；确认网络可信后再放开。
# APP_BIND="0.0.0.0"
# DB_BIND="0.0.0.0"
# 覆盖数据库口令（同时注入 Postgres 与应用连接串）；仅在首次创建数据卷时生效。
# POSTGRES_PASSWORD="替换为强口令"
